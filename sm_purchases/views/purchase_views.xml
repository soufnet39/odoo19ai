<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =============================== -->
    <!-- VUE LISTE DES COMMANDES D'ACHAT -->
    <!-- =============================== -->
    <record id="view_sm_purchases_purchase_list" model="ir.ui.view">
        <field name="name">sm_purchases.purchase.list</field>
        <field name="model">sm_sales.order</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <list string="Achats" decoration-warning="state == 'draft'" decoration-success="state == 'confirmed'" decoration-danger="state == 'canceled'"  decoration-bf="1">
                <field name="name" string="Achat"/>
                <field name="date"/>
                <field name="partner_id" string="Fournisseur"/>
                <field name="user_id"/>
                <field name="state" widget="badge"/>
                <field name="amount_ttc" sum="Total TTC"/>
            </list>
        </field>
    </record>

    <!-- =============================== -->
    <!-- VUE FORMULAIRE DES COMMANDES D'ACHAT -->
    <!-- =============================== -->
    <record id="view_sm_purchases_purchase_form" model="ir.ui.view">
        <field name="name">sm_purchases.purchase.form</field>
        <field name="model">sm_sales.order</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <form string="Commande d'achat">
                <header>
                    <button name="action_confirm" string="Confirme" type="object"
                            class="btn btn-success" invisible="(state != 'draft') or (create_date == write_date)"/>
                    <button name="print_purchase" string="Imprimer l'achat" type="object"
                            class="btn btn-info" icon="fa-print" invisible="create_date == write_date"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,canceled"/>
                </header>

                <sheet>
                <field name="operation_type" force_save="1" invisible="1"/>
                    <widget name="web_ribbon" title="Annulée" bg_color="bg-warning"
                            invisible="state != 'canceled'"/>
                    <group>
                        <group>
                            <div class="oe_title">
                                <h1>
                                    <field name="name" readonly="not name_updatable"/>
                                </h1>
                            </div>
                        </group>
                        <group string="Informations sur le document" class='sm_group mb-0'>
                            <field name="partner_id" required="1" string="Fournisseur"  domain="[('is_supplier', '=', True)]" context="{'default_is_supplier': True}"/>
                            <field name="date"/>
                            <field name="user_id" readonly="1" options="{'no_open': True}" />
                            
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes">
                            <field name="can_change_product_designation_on_purchases" invisible="1" />
                            <field name="order_lines">
                                <list id="detail_list" string="Lignes d'achat"  decoration-bf="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_code" optional="hide"/>
                                    <field name="code_supplier" optional="hide"/>
                                    <field name="name"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="price_total"/>
                                    <control>
                                       <create string="Ajouter un article"/>
                                    </control>
                                </list>
                                <form>
                                        <group id='add_article' col="12">
                                            <group colspan='8' class="sm_group">
                                                <field name="product_id" domain="[('purchase_ok', '=', True)]"/>
                                                <field name="name" invisible="not parent.can_change_product_designation_on_purchases" />
                                                <field name="qty"/>
                                                <field name="unit_price"/>
                                                <field name="price_total"/>

                                            </group>
                                            <group colspan='4' >
                                                 <field name="image_128" widget='image' nolabel="1"/>
                                            </group>
                                        </group>

                                </form>
                            </field>
                        </page>
                        <page string="Options" class="px-3">
                                <group>                               
                                    <field name="tva_enabled"/>
                                    <field name="tva_taux" invisible="not tva_enabled"/>
                                </group>
                                <hr/>
                                <group>
                                    <field name="remise_exist"/>
                                    <field name="remise_methode" invisible="not remise_exist"/>
                                    <field name="remise_taux"
                                        invisible="not remise_exist or remise_methode != 'taux'"/>
                                    <field name="remise_mta"
                                        invisible="not remise_exist or remise_methode != 'mta'"/>
                                </group>
                                <hr/>
                                <group>
                                   <field name="can_change_product_designation_on_purchases"/>
                                </group>
                                <hr/>
                                <group>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                        </page>
                        <page string="Opérations">
                            <button name="action_cancel" class="btn btn-warning" string="Annuler" type="object" invisible="state != 'confirmed'"/>
                            <button name="action_draft" class="btn btn-danger" string="Brouillon" type="object" invisible="state != 'canceled'"/>
                        </page>
                    </notebook>
                    <group>
                        <group>
                            <field name="mode_paiement_id"/>
                            <field name="note" widget="html" placeholder="Notes..."/>
                        </group>
                        <group id='totaux' class="oe_subtotal_footer me-4">
                            <field name="amount_ht_before_remise" class="text-end" invisible="not remise_exist or not tva_enabled"/>
                            <field name="amount_ht_before_remise" class="text-end" string="Montant avant remise" invisible="not remise_exist or tva_enabled"/>
                            <field name="remise_valeur" string="Remise" class="text-end" invisible="not remise_exist"/>
                            <field name="amount_ht" class="text-end" invisible="not tva_enabled"/>
                            <field name="amount_tva" class="text-end" invisible="not tva_enabled"/>
                            <field name="amount_ttc" class="text-end" invisible="not tva_enabled"/>
                            <field name="amount_ttc" class="text-end" string="Total" invisible="tva_enabled"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- =============================== -->
    <!-- VUE RECHERCHE DES COMMANDES D'ACHAT -->
    <!-- =============================== -->
    <record id="view_sm_purchases_purchase_search" model="ir.ui.view">
        <field name="name">sm_purchases.purchase.search</field>
        <field name="model">sm_sales.order</field>
        <field name="arch" type="xml">
            <search string="Achats">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <filter name="filter_draft" string="Brouillon"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmées"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_canceled" string="Annulées"
                        domain="[('state', '=', 'canceled')]"/>

                <filter name="group_state" string="Etat"
                        context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="Fournisseur"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="group_user" string="Vendeur"
                        context="{'group_by': 'user_id'}"/>
                <filter name="group_date" string="Date"
                        context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <!-- =============================== -->
    <!-- ACTION FENÊTRE DES COMMANDES D'ACHAT -->
    <!-- =============================== -->
    <record id="action_sm_purchases_purchase" model="ir.actions.act_window">
        <field name="name">Achats</field>
        <field name="res_model">sm_sales.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sm_purchases_purchase_search"/>
        <field name="context">{'default_operation_type': 'purchase'}</field>
        <field name="domain">[('operation_type','=','purchase')]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_id': ref('view_sm_purchases_purchase_list'), 'view_mode': 'list'}), (0, 0, {'view_id': ref('view_sm_purchases_purchase_form'), 'view_mode': 'form'})]"/>
   </record>

</odoo>