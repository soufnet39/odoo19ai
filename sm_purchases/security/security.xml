<?xml version="1.0" encoding="utf-8"?>
<odoo>
 
    <!-- Catégorie des groupes Achats SM -->
        <record id="module_category_sm_purchases" model="ir.module.category">
            <field name="name">Achats SM</field>
            <field name="sequence">100</field>
        </record>

        <!-- Privilège des groupes Achats SM -->
        <record id="module_privilege_sm_purchases" model="res.groups.privilege">
            <field name="name">Achats SM</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="module_category_sm_purchases"/>
        </record>

        <!-- Groupe de base : sm_purchases_user -->
        <record id="sm_purchases_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="privilege_id" ref="module_privilege_sm_purchases"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Groupe gestionnaire : hérite des privilèges de sm_purchases_user -->
        <record id="sm_purchases_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="privilege_id" ref="module_privilege_sm_purchases"/>
            <field name="implied_ids" eval="[(4, ref('sm_purchases_user'))]"/>
        </record>

        <!-- Groupe administrateur : hérite des privilèges de sm_purchases_manager -->
        <record id="sm_purchases_admin" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="privilege_id" ref="module_privilege_sm_purchases"/>
            <field name="implied_ids" eval="[(4, ref('sm_purchases_manager'))]"/>
        </record>


</odoo>
