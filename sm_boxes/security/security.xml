<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Catégorie des groupes Caisses SM -->
        <record id="module_category_sm_boxes" model="ir.module.category">
            <field name="name">Caisses SM</field>
            <field name="sequence">100</field>
        </record>

        <!-- Privilège des groupes Caisses SM -->
        <record id="module_privilege_sm_boxes" model="res.groups.privilege">
            <field name="name">Caisses SM</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="module_category_sm_boxes"/>
        </record>

        <!-- Groupe de base : sm_boxes_user -->
        <record id="sm_boxes_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="privilege_id" ref="module_privilege_sm_boxes"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Groupe gestionnaire : hérite des privilèges de sm_boxes_user -->
        <record id="sm_boxes_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="privilege_id" ref="module_privilege_sm_boxes"/>
            <field name="implied_ids" eval="[(4, ref('sm_boxes_user'))]"/>
        </record>

        <!-- Groupe administrateur : hérite des privilèges de sm_boxes_manager -->
        <record id="sm_boxes_admin" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="privilege_id" ref="module_privilege_sm_boxes"/>
            <field name="implied_ids" eval="[(4, ref('sm_boxes_manager'))]"/>
        </record>

           <!-- Règles d'accès : les listes de prix sont visibles/utilisables uniquement par les utilisateurs assignés.
               Une liste de prix sans utilisateurs (user_ids vide) reste visible par tous. -->
