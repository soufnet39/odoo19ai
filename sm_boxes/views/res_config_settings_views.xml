<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_sm_boxes" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sm_boxes</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <app data-string="Caisses" string="Caisses" name="sm_boxes" >

                    <block title="Affichage" name="sm_boxes_display">
                        <setting id="sm_boxes_show_client_payment"
                                 string="Paiements clients"
                                 help="Afficher les paiements des clients dans les opérations.">
                            <field name="show_client_payment"/>
                        </setting>
                        <setting id="sm_boxes_show_supplier_payment"
                                 string="Règlements fournisseurs"
                                 help="Afficher les règlements des fournisseurs dans les opérations.">
                            <field name="show_supplier_payment"/>
                        </setting>
                    </block>

                </app>

            </xpath>

        </field>
    </record>

</odoo>
