<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== -->
    <!-- VUES DES OPÉRATIONS -->
    <!-- ==================== -->

    <!-- Vue liste -->
    <record id="sm_boxes_operations_view_list" model="ir.ui.view">
        <field name="name">sm_boxes.operations.list</field>
        <field name="model">sm_boxes.operations</field>
        <field name="arch" type="xml">
            <list  decoration-bf="1">
                <field name="date"/>
                <field name="operation"/>
                <field name="name"/>
                <field name="boxe_id"/>
                <field name="partner_id"/>
                <field name="mode"/>
                <field name="amount" sum="Total"/>
                <field name="sens"/>
                <field name="user_id"/>
                <field name="reference" optional="hode"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="sm_boxes_operations_view_form" model="ir.ui.view">
        <field name="name">sm_boxes.operations.form</field>
        <field name="model">sm_boxes.operations</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Motif"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="operation"/>
                            <field name="sens"/>
                            <field name="boxe_id"/>
                            <field name="date"/>
                            <field name="mode"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="amount_done" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <field name="reference"/>
                        </group>
                    </group>
                    <group string="Liens">
                        <group>
                            <field name="order_id"/>
                        </group>
                       
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue recherche -->
    <record id="sm_boxes_operations_view_search" model="ir.ui.view">
        <field name="name">sm_boxes.operations.search</field>
        <field name="model">sm_boxes.operations</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="boxe_id"/>
                <field name="operation"/>
                <field name="partner_id"/>

                <!-- <filter name="filter_draft" string="Brouillon"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmées"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_canceled" string="Annulées"
                        domain="[('state', '=', 'canceled')]"/>
                 <separator/>    -->
                <filter name="filter_recette" string="Recette" domain="[('operation','=','recette')]"/>
                <filter name="filter_depence" string="Dépense" domain="[('operation','=','depence')]"/>
                
                <filter name="group_boxe" string="Compte" context="{'group_by': 'boxe_id'}"/>
                <filter name="group_operation" string="Opération" context="{'group_by': 'operation'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="sm_boxes_operations_action_encaissement" model="ir.actions.act_window">
        <field name="name">Ajouter Encaissement</field>
        <field name="res_model">sm_boxes.operations</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_operation': 'encaissement','default_sens': 'credit'}</field>
        <field name="search_view_id" ref="sm_boxes_operations_view_search"/>
    </record>

    <record id="sm_boxes_operations_action_decaissement" model="ir.actions.act_window">
        <field name="name">Ajouter Décaissement</field>
        <field name="res_model">sm_boxes.operations</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_operation': 'decaissement','default_sens': 'debit'}</field>
        <field name="search_view_id" ref="sm_boxes_operations_view_search"/>
    </record>

    <record id="sm_boxes_operations_action" model="ir.actions.act_window">
        <field name="name">Mouvements de Comptes</field>
        <field name="res_model">sm_boxes.operations</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sm_boxes_operations_view_search"/>
    </record>
        <!-- <field name="context">{'search_default_filter_confirmed': 1}</field> -->

    <!-- Éléments de menu -->
    <menuitem id="sm_boxes_operations_menu_action_encaissement"
              name="Ajouter Encaissement"
              parent="sm_boxes_menu_root"
              action="sm_boxes_operations_action_encaissement"
              sequence="10"/>

    <menuitem id="sm_boxes_operations_menu_action_decaissement"
              name="Ajouter Décaissement"
              parent="sm_boxes_menu_root"
              action="sm_boxes_operations_action_decaissement"
              sequence="15"/>

    <menuitem id="sm_boxes_operations_menu_action"
              name="Mouvements de Comptes"
              parent="sm_boxes_menu_root"
              action="sm_boxes_operations_action"
              sequence="5"/>


</odoo>