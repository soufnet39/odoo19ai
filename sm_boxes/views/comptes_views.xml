<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue liste -->
    <record id="sm_boxes_view_list" model="ir.ui.view">
        <field name="name">sm_boxes.list</field>
        <field name="model">sm_boxes.boxes</field>
        <field name="arch" type="xml">
            <list  decoration-bf="1">
                <field name="name"/>
                <field name="boxe_type"/>
                <field name="boxe_sold" groups="sm_boxes.sm_boxes_admin" decoration-danger="boxe_sold &lt; 0" decoration-success="boxe_sold &gt; 0"/>
                <field name="can_be_negatif"/>
                <field name="user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="sm_boxes_view_form" model="ir.ui.view">
        <field name="name">sm_boxes.form</field>
        <field name="model">sm_boxes.boxes</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_operations"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list-alt"
                                invisible="not id"
                                groups="sm_boxes.sm_boxes_admin">
                            <div class="o_stat_info">
                                <span class="o_stat_text">
                                    Solde: <field name="boxe_sold" class="d-inline fw-bold" decoration-danger="boxe_sold &lt; 0" decoration-success="boxe_sold &gt; 0"/>
                                </span>
                                <span class="o_stat_text">Opérations</span>
                            </div>
                        </button>
                    </div>
                    <style>
                        .oe_indent {
                            margin-left: 33.33%;
                            width: 40%;
                        }
                    </style>
                    <field name="id" invisible="1"/>
                    <div class="oe_title h1">
                        <span class="text-danger">Caisse</span>
                        <span invisible="id" class="text-muted"> / Création</span>
                        <span invisible="not id" class="text-muted"> / Edition</span>
                    </div>
                    <group class="oe_indent">                   
                        <field name="name"/>
                        <field name="boxe_type"/>
                        <field name="bank_id" invisible="boxe_type != 'bank'" required="boxe_type == 'bank'" options="{'no_open': True}" />
                        <field name="rib" invisible="boxe_type != 'bank'"/>
                        <field name="can_be_negatif"/>
                    </group>
                <hr/>
                <group>
                     <field name="user_ids" widget="many2many_tags"/>
                </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="sm_boxes_action" model="ir.actions.act_window">
        <field name="name">Liste des Comptes</field>
        <field name="res_model">sm_boxes.boxes</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
