<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue liste -->
    <record id="sm_boxes_view_list" model="ir.ui.view">
        <field name="name">sm_boxes.list</field>
        <field name="model">sm_boxes.boxes</field>
        <field name="arch" type="xml">
            <list  decoration-bf="1">
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="sm_boxes_view_form" model="ir.ui.view">
        <field name="name">sm_boxes.form</field>
        <field name="model">sm_boxes.boxes</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="boxe_type"/>
                    </group>
                </group>
                <group>
                    <group invisible="boxe_type != 'bank'">
                        <field name="rib" />
                        <field name="bank_id" required="boxe_type == 'bank'" options="{'no_open': True}" />
                    </group>
                </group>
                <hr/>
                <group>
                     <field name="user_ids" widget="many2many_tags"/>
                </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="sm_boxes_action" model="ir.actions.act_window">
        <field name="name">Liste des Comptes</field>
        <field name="res_model">sm_boxes.boxes</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
