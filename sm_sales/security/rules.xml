<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Règles d'accès : accès multi-sociétés pour quotation -->
        <record id="sm_sales_order_rule_company" model="ir.rule">
            <field name="name">Quotation SM : multi-sociétés</field>
            <field name="model_id" ref="model_sm_sales_quotation"/>
            <field name="domain_force">['|', ('company_id','=',False),('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sm_sales_user'))]"/>
        </record>
    <!-- Règles d'accès : accès multi-sociétés pour order -->
        <record id="sm_sales_order_rule_company" model="ir.rule">
            <field name="name">Commande SM : multi-sociétés</field>
            <field name="model_id" ref="model_sm_sales_order"/>
            <field name="domain_force">['|', ('company_id','=',False),('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sm_sales_user'))]"/>
        </record>
    <!-- Règles d'accès : accès multi-sociétés pour les partenaires -->
        <record id="sm_sales_partner_rule_company" model="ir.rule">
            <field name="name">Partenaire SM : multi-sociétés</field>
            <field name="model_id" ref="model_sm_sales_partner"/>
            <field name="domain_force">['|', ('company_id','=',False),('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sm_sales_user'))]"/>
        </record>
