<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Catégorie des groupes Ventes SM -->
        <record id="module_category_sm_sales" model="ir.module.category">
            <field name="name">Ventes SM</field>
            <field name="sequence">100</field>
        </record>

        <!-- Privilège des groupes Ventes SM -->
        <record id="module_privilege_sm_sales" model="res.groups.privilege">
            <field name="name">Ventes SM</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="module_category_sm_sales"/>
        </record>

        <!-- Groupe de base : sm_sales_user -->
        <record id="sm_sales_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="privilege_id" ref="module_privilege_sm_sales"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Groupe gestionnaire : hérite des privilèges de sm_sales_user -->
        <record id="sm_sales_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="privilege_id" ref="module_privilege_sm_sales"/>
            <field name="implied_ids" eval="[(4, ref('sm_sales_user'))]"/>
        </record>

        <!-- Groupe administrateur : hérite des privilèges de sm_sales_manager -->
        <record id="sm_sales_admin" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="privilege_id" ref="module_privilege_sm_sales"/>
            <field name="implied_ids" eval="[(4, ref('sm_sales_manager'))]"/>
        </record>

           <!-- Règles d'accès : les listes de prix sont visibles/utilisables uniquement par les utilisateurs assignés.
               Une liste de prix sans utilisateurs (user_ids vide) reste visible par tous. -->
        <record id="sm_sales_pricelist_user_rule" model="ir.rule">
            <field name="name">Liste de prix : utilisateurs assignés uniquement</field>
            <field name="model_id" ref="model_sm_sales_pricelist"/>
            <field name="groups" eval="[(4, ref('sm_sales_user'))]"/>
            <field name="domain_force">['|', ('user_ids', '=', False), ('user_ids', 'in', user.id)]</field>
        </record>

        <record id="sm_sales_pricelist_price_user_rule" model="ir.rule">
            <field name="name">Prix de la liste : utilisateurs assignés uniquement</field>
            <field name="model_id" ref="model_sm_sales_pricelist_price"/>
            <field name="groups" eval="[(4, ref('sm_sales_user'))]"/>
            <field name="domain_force">['|', ('pricelist_id.user_ids', '=', False), ('pricelist_id.user_ids', 'in', user.id)]</field>
        </record>

    </data>
</odoo>
