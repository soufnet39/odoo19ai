<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================= -->
    <!-- VUES DES CATÉGORIES DE PRODUITS -->
    <!-- ======================= -->

    <!-- Vue liste -->
    <record id="sm_sales_product_category_list" model="ir.ui.view">
        <field name="name">sm_sales.product.category.list</field>
        <field name="model">sm_sales.product.category</field>
        <field name="arch" type="xml">
            <list decoration-bf="1">
                <field name="name"/>
                <field name="product_count"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="sm_sales_product_category_form" model="ir.ui.view">
        <field name="name">sm_sales.product.category.form</field>
        <field name="model">sm_sales.product.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la catégorie"/>
                        </h1>
                    </div>
                   
                    
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue recherche -->
    <record id="sm_sales_product_category_search" model="ir.ui.view">
        <field name="name">sm_sales.product.category.search</field>
        <field name="model">sm_sales.product.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sm_sales_product_category" model="ir.actions.act_window">
        <field name="name">Catégories de produits</field>
        <field name="res_model">sm_sales.product.category</field>
        <field name="view_mode">list,form</field>
        <field name="path">product_categories</field>
        <field name="search_view_id" ref="sm_sales_product_category_search"/>
    </record>

</odoo>