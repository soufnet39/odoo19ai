<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================== -->
    <!-- VUES DES BANQUES -->
    <!-- ======================== -->

    <!-- Vue liste -->
    <record id="sm_sales_bank_list" model="ir.ui.view">
        <field name="name">sm_sales.bank.list</field>
        <field name="model">sm_sales.bank</field>
        <field name="arch" type="xml">
            <list decoration-bf="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="reference"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="sm_sales_bank_form" model="ir.ui.view">
        <field name="name">sm_sales.bank.form</field>
        <field name="model">sm_sales.bank</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <style>
                        .oe_title h1 {
                            text-align: center;
                            color: odoo_customize_get(' --info' ) or #875A7B;
                        }
                        .oe_indent {
                            margin-left: 25%;
                        }
                    </style>
                    <div class="oe_title">
                        <h1 class="text-danger">Banque</h1>
                    </div>
                    <group class="oe_indent">
                        <field name="name" placeholder="Nom de la banque"/>
                        <field name="sequence"/>
                        <field name="reference"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue recherche -->
    <record id="sm_sales_bank_search" model="ir.ui.view">
        <field name="name">sm_sales.bank.search</field>
        <field name="model">sm_sales.bank</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sm_sales_bank" model="ir.actions.act_window">
        <field name="name">Banques</field>
        <field name="res_model">sm_sales.bank</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sm_sales_bank_search"/>
    </record>

</odoo>
