<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== -->
    <!-- VUES DES MÉTHODES DE PAIEMENT -->
    <!-- ==================== -->

    <!-- Vue liste -->
    <record id="sm_sales_payment_method_list" model="ir.ui.view">
        <field name="name">sm_sales.payment.method.list</field>
        <field name="model">sm_sales.payment.method</field>
        <field name="arch" type="xml">
            <list decoration-bf="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_default"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="sm_sales_payment_method_form" model="ir.ui.view">
        <field name="name">sm_sales.payment.method.form</field>
        <field name="model">sm_sales.payment.method</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la méthode de paiement"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue recherche -->
    <record id="sm_sales_payment_method_search" model="ir.ui.view">
        <field name="name">sm_sales.payment.method.search</field>
        <field name="model">sm_sales.payment.method</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="filter_active" string="Actif" domain="[('active','=',True)]"/>
                <filter name="filter_inactive" string="Inactif" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sm_sales_payment_method" model="ir.actions.act_window">
        <field name="name">Méthodes de paiement</field>
        <field name="res_model">sm_sales.payment.method</field>
        <field name="view_mode">list,form</field>
        <field name="path">payment_methods</field>
        <field name="search_view_id" ref="sm_sales_payment_method_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

</odoo>
