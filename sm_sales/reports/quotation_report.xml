<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action du rapport -->
    <record id="action_report_quotation" model="ir.actions.report">
        <field name="name">Proforma client</field>
        <field name="model">sm_sales.quotation</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">sm_sales.report_quotation</field>
        <field name="report_file">sm_sales.report_quotation</field>
        <field name="print_report_name">'Proforma - %s' % (object.name)</field>
        <field name="binding_model_id" ref=""/>
        <field name="binding_type">report</field>        
    </record>

    <!-- Modèle QWeb -->
    <template id="report_quotation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="quotation">
               <t t-call="sm_base.external_layout_sm">
                    <t t-set="doc" t-value="quotation"/>
                    <link rel="stylesheet" type="text/css" href="/sm_sales/static/src/css/doc.css"/>
                    <div class="page">
                        <!-- Informations d'en-tête -->
                        
                        <div class="row mt-4">
                            <div class="col-5 text-center">
                                <strong class="h3">Facture Proforma </strong> <br/>
                                <span class="h4" t-field="quotation.name"/>
                            </div>
                            <div class="col-7" style="font-size:10pt">
                                    <div class="row">
                                        <div class="col-3 text-end">
                                            <strong>Client :</strong>
                                        </div>
                                        <div class="col-9">
                                            <span style="font-weight:bold; " t-field="doc.partner_id.name" />
                                            <t t-if="doc.partner_id.address">
                                                <br/>
                                                <span t-field="doc.partner_id.address" />
                                                ,
                                                <span t-field="doc.partner_id.wilaya_id" />
                                            </t>
                                        </div>
                                    </div>
                                    <div class="row" t-if="doc.partner_id.reg_com">
                                        <div class="col-3 text-end" >
                                            Reg.Com :
                                        </div>
                                        <div class="col-9">
                                            <span t-field="doc.partner_id.reg_com"/>
                                        </div>
                                    </div>
                                     <div class="row" t-if="doc.partner_id.art_imp">
                                        <div class="col-3 text-end" >
                                            Art.Imp :
                                        </div>
                                        <div class="col-9" >
                                            <span t-field="doc.partner_id.art_imp"/>
                                        </div>
                                    </div>
                                    <div class="row" t-if="doc.partner_id.nif">
                                        <div class="col-3 text-end" >
                                            N.I.F. :
                                        </div>
                                        <div class="col-9">
                                            <span t-field="doc.partner_id.nif"/>
                                        </div>
                                    </div>
                                     <div class="row" t-if="doc.partner_id.nis">
                                        <div class="col-3 text-end" >
                                            N.I.S. :
                                        </div>
                                        <div class="col-9">
                                            <span t-field="doc.partner_id.nis"/>
                                        </div>
                                    </div>
                                   
                            </div>
                        </div>

                        <!-- Lignes de proforma -->
                        <table  class="w-100 mt-4 mb-2 table-borderless" >
                          <tr> 
                            <td class="text-start">
                              Suivi par: <span t-field="quotation.user_id"/>
                            </td>
                            <td class="text-end">
                               Date: <span t-field="quotation.date"/>
                            </td>
                          </tr>
                        </table>
                        <table class="table table-sm mt-0 my-table">
                            <thead>
                                <tr>
                                    <th>Désignation</th>
                                    <th class="text-end">Quantité</th>
                                    <th class="text-end">Prix unitaire</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="quotation.quotation_lines" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.qty"/></td>
                                    <td class="text-end"><span t-field="line.unit_price"/></td>
                                    <td class="text-end"><span t-field="line.price_total"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Totaux -->
                        <div class="row mt-4">
                            <div class="col-6"/>
                            <div class="col-6">
                                <table class="table table-sm">
                                    <tr t-if="quotation.remise_exist">
                                        <td><strong>Avant remise :</strong></td>
                                        <td class="text-end"><span t-field="quotation.amount_ht_before_remise"/></td>
                                    </tr>
                                    <tr t-if="quotation.remise_exist">
                                        <td><strong>Remise :</strong></td>
                                        <td class="text-end"><span t-field="quotation.remise_valeur"/></td>
                                    </tr>
                                    <tr t-if="quotation.tva_enabled">
                                        <td><strong>Sous-total HT :</strong></td>
                                        <td class="text-end"><span t-field="quotation.amount_ht"/></td>
                                    </tr>
                                    <tr t-if="quotation.tva_enabled">
                                        <td><strong>TVA :</strong></td>
                                        <td class="text-end"><span t-field="quotation.amount_tva"/></td>
                                    </tr>
                                    <tr class="fw-bold backy" >
                                        <td><strong>Total TTC:</strong></td>
                                        <td class="text-end"><span t-field="quotation.amount_ttc"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Note -->
                        <div t-if="doc.mode_paiement_id">
                            <span> Mode de paiement : </span> <span t-field="doc.mode_paiement_id"/>
                        </div>
                        <div t-if="doc.methode_paiement_id">
                            <span> Méthode de paiement : </span> <span t-field="doc.methode_paiement_id"/>
                        </div>
                        <div t-if="doc.condition_vente_id">
                            <span> Condition de vente : </span> <span t-field="doc.condition_vente_id"/>
                        </div>
                        <div t-if="doc.validity_offre_id">
                            <span> Validité de l'offre : </span> <span t-field="doc.validity_offre_id"/>
                        </div>
                        <div t-if="quotation.note" class="mt-4">
                            <strong>Notes :</strong>
                            <div t-field="quotation.note"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
