<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Catégorie des groupes Base SM -->
        <record id="module_category_sm_base" model="ir.module.category">
            <field name="name">Base SM</field>
            <field name="sequence">100</field>
        </record>

        <!-- Privilège des groupes Base SM -->
        <record id="module_privilege_sm_base" model="res.groups.privilege">
            <field name="name">Base SM</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="module_category_sm_base"/>
        </record>

        <!-- Groupe de base : sm_base_user -->
        <record id="sm_base_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="privilege_id" ref="module_privilege_sm_base"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Groupe gestionnaire : hérite des privilèges de sm_base_user -->
        <record id="sm_base_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="privilege_id" ref="module_privilege_sm_base"/>
            <field name="implied_ids" eval="[(4, ref('sm_base_user'))]"/>
        </record>

        <!-- Groupe administrateur : hérite des privilèges de sm_base_manager -->
        <record id="sm_base_admin" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="privilege_id" ref="module_privilege_sm_base"/>
            <field name="implied_ids" eval="[(4, ref('sm_base_manager'))]"/>
        </record>


    </data>
</odoo>
