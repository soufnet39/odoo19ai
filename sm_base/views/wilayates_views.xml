<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- VUE RECHERCHE                                                 -->
    <!-- ============================================================ -->
    <record id="sm_base_wilayates_search" model="ir.ui.view">
        <field name="name">sm_base.wilayates.search</field>
        <field name="model">sm_base.wilayates</field>
        <field name="arch" type="xml">
            <search string="Rechercher des wilayas">
                <field name="name"/>
                <field name="code"/>
                <filter string="Actif" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archivé" name="archived" domain="[('active', '=', False)]"/>
               
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- VUE LISTE                                                     -->
    <!-- ============================================================ -->
    <record id="sm_base_wilayates_list" model="ir.ui.view">
        <field name="name">sm_base.wilayates.list</field>
        <field name="model">sm_base.wilayates</field>
        <field name="arch" type="xml"> 
            <list string="Wilayas" multi_edit="1" sample="1"  decoration-bf="1">
                <field name="sequence" widget="handle" />
                <field name="code" readonly="1" />
                <field name="name" />
                <field name="active" optional="hide" />
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- VUE FORMULAIRE                                                -->
    <!-- ============================================================ -->
    <record id="sm_base_wilayates_form" model="ir.ui.view">
        <field name="name">sm_base.wilayates.form</field>
        <field name="model">sm_base.wilayates</field>
        <field name="arch" type="xml">
            <form string="Wilaya">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="ex. Alger" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. 16" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACTION                                                        -->
    <!-- ============================================================ -->
    <record id="sm_base_wilayates_action" model="ir.actions.act_window">
        <field name="name">Wilayas</field>
        <field name="res_model">sm_base.wilayates</field>       
        <field name="path">wilayates</field>
        <field name="view_id" ref="sm_base_wilayates_list" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première wilaya
            </p>
            <p>
                Divisions administratives algériennes utilisées dans l'écosystème Smail.
            </p>
        </field>
    </record>

</odoo>
