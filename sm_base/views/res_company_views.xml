<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Étend le formulaire Société avec les champs de SM Base         -->
    <!-- ============================================================ -->
    <record id="res_company_form_view_sm_base" model="ir.ui.view">
        <field name="name">res.company.form.sm_base</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <!-- ── Localisation ─────────────────────────────── -->
            <xpath expr="//group[@name='social_media']" position="after">
                <group string="Localisation">
                    <field name="wilaya_id" />
                    <field name="boite_postale" />
                </group>
            </xpath>

            <!-- ── Coordonnées ──────────────────────────────── -->
            <xpath expr="//field[@name='phone']" position="after">
                <field name="mobile" />
                <field name="fax" />
            </xpath>
            <field name="name" position="after">
               <field name='slogon' placeholder="Slogon" style="font-size:12pt" />
            </field>

            <!-- ── Identifiants fiscaux et commerciaux ──────── -->
            <xpath expr="//group[@name='social_media']" position="before">
                <group string="Identifiants fiscaux et commerciaux algériens">
                    <group>
                        <field name="nis" />
                        <field name="m_fisc" />
                        <field name="a_imp" />
                    </group>
                    <group>
                        <field name="rib" />
                        <field name="reg_com" />
                        <field name="capital_social" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
