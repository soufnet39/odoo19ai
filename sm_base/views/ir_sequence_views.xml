<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Vue liste pour ir.sequence -->
    <record id="view_sequence_shakliyat_list" model="ir.ui.view">
        <field name="name">ir.sequence.shakliyat.list</field>
        <field name="model">ir.sequence</field>
        <field name="arch" type="xml">
            <list string="Séquences"  decoration-bf="1">
                <field name="name"/>
                <field name="prefix"/>
                <field name="padding" string="Taille de la séquence"/>
                <field name="number_next_actual" string="Prochain numéro"/>
                <field name="number_increment" string="Pas"/>
                <field name="company_id" string="Filiale"/>
            </list>
        </field>
    </record>


    <!-- Vue formulaire héritée de la base -->
    <record id="view_sequence_shakliyat_form" model="ir.ui.view">
        <field name="name">ir.sequence.shakliyat.form</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view"/>
        <field name="arch" type="xml">
           <field name="code" position="replace" />
        </field>
    </record>


    <!-- Action -->
    <record id="action_sequence_shakliyat" model="ir.actions.act_window">
        <field name="name">Séquences</field>
        <field name="res_model">ir.sequence</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_id': ref('view_sequence_shakliyat_list'), 'view_mode': 'list'}), (0, 0, {'view_id': ref('view_sequence_shakliyat_form'), 'view_mode': 'form'})]"/>

    </record>

 

    <!-- Élément de menu Séquences sous Configuration -->
    <menuitem id="menu_sequence_shakliyat"
              name="Séquences"
              parent="menu_sm_base_configurations"
              action="action_sequence_shakliyat"
              groups="base.group_system"
              sequence="99"/>

</odoo>
