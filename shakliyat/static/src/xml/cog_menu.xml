<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Shakliyat — replace the gear icon button in the CogMenu / context menu
        with a solid silver "Actions" button.

        Unlike t-inherit-mode="extension" (which only patches the base template
        and is invisible to templates that inherit from it in Odoo 19's asset
        loader), these are t-inherit-mode="primary" templates: each one is a
        standalone new template that inherits from web.CogMenu (or from the
        shakliyat variant) and applies xpath patches on top. The corresponding
        JS (cog_menu.js) then points every CogMenu component at the shakliyat
        variant, so the change appears in forms, lists, kanbans, graphs and pivots.
    -->

    <!-- shakliyat.CogMenu: base override of web.CogMenu -->
    <t t-inherit="web.CogMenu" t-name="shakliyat.CogMenu">
        <!-- Replace the <i class="fa fa-fw fa-cog"/> icon with a text label. -->
        <xpath expr="//button[hasclass('d-print-none')]/i[hasclass('fa-cog')]" position="replace">
            <span>Actions</span>
        </xpath>

        <!-- The original button switches between a borderless desktop variant
             and btn-secondary on mobile. We always want a solid silver button,
             so we set a fixed class and remove the dynamic t-att-class. -->
        <xpath expr="//button[hasclass('d-print-none')]" position="attributes">
            <attribute name="class">d-print-none btn btn-secondary o_shakliyat_action_button</attribute>
            <attribute name="t-att-class"></attribute>
        </xpath>
    </t>

    <!--
        shakliyat.FormCogMenu: inherits from shakliyat.CogMenu (NOT web.CogMenu)
        so our icon replacement is preserved, then re-applies the FormCogMenu-
        specific patches that Odoo's web.FormCogMenu normally adds.
    -->
    <t t-inherit="shakliyat.CogMenu" t-name="shakliyat.FormCogMenu">
        <!-- On desktop, only show the cog menu when there are items (or on
             small screens). The base template uses t-if="hasItems" only. -->
        <xpath expr="//div[hasclass('o_cp_action_menus')]" position="attributes">
            <attribute name="t-if">env.isSmall or hasItems</attribute>
        </xpath>

        <!-- Separator before the Print dropdown (matches web.FormCogMenu). -->
        <xpath expr="//t[@t-if='state.printItems.length']/Dropdown" position="before">
            <div role="separator" class="dropdown-divider"/>
        </xpath>
    </t>

    <!-- shakliyat.ListCogMenu: same patches as web.ListCogMenu -->
    <t t-inherit="shakliyat.CogMenu" t-name="shakliyat.ListCogMenu">
        <xpath expr="//t[@t-if='state.printItems.length']/Dropdown" position="before">
            <div role="separator" class="dropdown-divider"/>
        </xpath>
    </t>

    <!-- shakliyat.KanbanCogMenu: same patches as web.KanbanCogMenu -->
    <t t-inherit="shakliyat.CogMenu" t-name="shakliyat.KanbanCogMenu">
        <xpath expr="//t[@t-if='state.printItems.length']/Dropdown" position="before">
            <div role="separator" class="dropdown-divider"/>
        </xpath>
    </t>

    <!-- shakliyat.ControlPanel: add slot for sheet-aligned actions at the right edge of breadcrumbs -->
    <t t-inherit="web.ControlPanel" t-name="shakliyat.ControlPanel">
        <xpath expr="//div[hasclass('o_control_panel_breadcrumbs')]" position="inside">
            <t t-slot="control-panel-sheet-actions"/>
        </xpath>
    </t>

    <!--
        shakliyat.FormView: moves the ButtonBox (smart buttons) and CogMenu ("Actions" button)
        into the control-panel-sheet-actions slot, placing smart buttons immediately before
        the Actions button, aligned with the right edge of the form sheet.
    -->
    <t t-inherit="web.FormView" t-name="shakliyat.FormView">
        <!-- Remove CogMenu from the additional-actions slot (keep only the
             button box template for small screens). -->
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']/CogMenu" position="replace">
        </xpath>

        <!-- Clear layout-actions so ButtonBox is not rendered on the right side over the chatter -->
        <xpath expr="//Layout/t[@t-set-slot='layout-actions']" position="replace">
            <t t-set-slot="layout-actions">
            </t>
        </xpath>

        <!-- Place ButtonBox and CogMenu into the control-panel-sheet-actions slot -->
        <xpath expr="//Layout/t[@t-set-slot='control-panel-status-indicator']" position="after">
            <t t-set-slot="control-panel-sheet-actions">
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <t t-if="!env.isSmall and buttonBoxTemplate">
                        <t t-call="{{ buttonBoxTemplate }}" t-call-context="{ __comp__: Object.assign(Object.create(this), { this, props: { ...this.props, record: this.model.root } }) }"/>
                    </t>
                    <CogMenu t-props="this.cogMenuProps" />
                </div>
            </t>
        </xpath>
    </t>

</templates>
