<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="shakliyat.LandingPage">
        <div class="o_shakliyat_landing_page h-100 d-flex flex-column">
            <!-- En-tête de bienvenue -->
            <div class="text-center py-5">
                <h1 class="display-4 fw-bold mb-3">Bienvenue sur votre tableau de bord</h1>
                <p class="lead text-muted">Sélectionnez une application pour commencer</p>
            </div>

            <!-- Conteneur de la grille des applications -->
            <div class="container flex-grow-1">
                <div class="row justify-content-center g-4">
                    <t t-foreach="apps" t-as="app" t-key="app.name">
                        <div class="col-md-4 col-sm-6">
                            <div class="card o_app_card h-100 shadow-sm"
                                 t-attf-style="border-top: 4px solid #{app.color || '#714B67'}"
                                 t-on-click="() => this.onAppClick(app)"
                                 role="button"
                                 tabindex="0">
                                <div class="card-body text-center p-4">
                                    <div class="mb-2">
                                        <i t-attf-class="fa #{app.icon} fa-3x"
                                           t-attf-style="color: #{app.color || '#714B67'}"/>
                                    </div>
                                    <h5 class="card-title fw-bold mb-2" t-esc="app.name"/>
                                    <p class="card-text text-muted small" t-esc="app.description"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- État vide (affiché lorsqu'aucune application n'est disponible) -->
                <div t-if="apps.length === 0" class="text-center py-5">
                    <div class="mb-4">
                        <i class="fa fa-th-large fa-4x text-muted"></i>
                    </div>
                    <h4 class="text-muted">Aucune application pour le moment</h4>
                    <p class="text-muted">Les applications apparaîtront ici une fois configurées.</p>
                </div>
            </div>

            <!-- Pied de page -->
            <div class="text-center py-3 text-muted small">
                <p class="mb-0">Powered par <strong>Mizan</strong></p>
            </div>
        </div>
    </t>

</templates>
