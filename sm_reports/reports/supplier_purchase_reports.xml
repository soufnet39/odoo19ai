<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================== -->
    <!-- PAPERFORMAT                          -->
    <!-- ==================================== -->
    <record id="paperformat_sm_reports_landscape" model="report.paperformat">
        <field name="name">SM Reports </field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <!-- ==================================== -->
    <!-- REPORT ACTIONS                       -->
    <!-- ==================================== -->
    <record id="action_report_supplier_purchases" model="ir.actions.report">
        <field name="name">Relevé des Achats Fournisseur</field>
        <field name="model">sm_reports.supplier.purchase</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">sm_reports.report_supplier_purchases</field>
        <field name="report_file">sm_reports.report_supplier_purchases</field>
        <field name="print_report_name">'Achats - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_sm_reports_landscape"/>
        <field name="binding_model_id" ref="model_sm_reports_supplier_purchase"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_supplier_payments" model="ir.actions.report">
        <field name="name">Relevé des Paiements Fournisseur</field>
        <field name="model">sm_reports.supplier.purchase</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">sm_reports.report_supplier_payments</field>
        <field name="report_file">sm_reports.report_supplier_payments</field>
        <field name="print_report_name">'Paiements - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_sm_reports_landscape"/>
        <field name="binding_model_id" ref="model_sm_reports_supplier_purchase"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ==================================== -->
    <!-- TEMPLATES                            -->
    <!-- ==================================== -->

    <!-- Shared header block -->
    <template id="report_supplier_header">
        <div class="mt-2 mb-3 d-flex justify-content-between align-items-start">
            <div>
                <h3 class="mb-0">
                    <span t-if="kind == 'purchases'">Relevé des Achats</span>
                    <span t-if="kind == 'payments'">Relevé des Paiements</span>
                </h3>
                <div class="text-muted">
                    Fournisseur : <span t-field="doc.partner_id"/>
                </div>
            </div>
            <div class="text-muted text-end" t-if="doc.date_from or doc.date_to">
                <strong>Période :</strong><br/>
                <span t-if="doc.date_from">Du <span t-field="doc.date_from"/></span>
                <span t-if="doc.date_to">Au <span t-field="doc.date_to"/></span>
            </div>
        </div>
    </template>

    <!-- Purchases report -->
    <template id="report_supplier_purchases">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="kind" t-value="'purchases'"/>
                        <t t-call="sm_reports.report_supplier_header"/>

                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Commande</th>
                                    <th>Date</th>
                                    <th class="text-end">Total TTC</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.purchase_ids" t-as="order">
                                    <td><span t-field="order.name"/></td>
                                    <td><span t-field="order.date"/></td>
                                    <td class="text-end">
                                        <span t-field="order.amount_ttc"
                                              t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                </tr>
                                <tr t-if="not doc.purchase_ids">
                                    <td colspan="3" class="text-center text-muted">Aucun achat</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2" class="text-end fw-bold">Nombre d'achats</td>
                                    <td class="text-end fw-bold"><span t-field="doc.purchase_count"/></td>
                                </tr>
                                <tr>
                                    <td colspan="2" class="text-end fw-bold">Total Achats</td>
                                    <td class="text-end fw-bold">
                                        <span t-field="doc.total_purchase"
                                              t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Payments report -->
    <template id="report_supplier_payments">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="kind" t-value="'payments'"/>
                        <t t-call="sm_reports.report_supplier_header"/>

                        <t t-set="modes"
                           t-value="dict(doc.payment_ids._fields['mode'].selection)"/>

                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Motif</th>
                                    <th>Date Opération</th>
                                    <th>Opération</th>
                                    <th>Mode</th>
                                    <th class="text-end">Montant</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.payment_ids" t-as="op">
                                    <td><span t-field="op.name"/></td>
                                    <td><span t-field="op.date"/></td>
                                    <td><span t-field="op.operation"/></td>
                                    <td><span t-esc="modes.get(op.mode, op.mode)"/></td>
                                    <td class="text-end">
                                        <span t-esc="-op.amount_done"
                                              t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                </tr>
                                <tr t-if="not doc.payment_ids">
                                    <td colspan="5" class="text-center text-muted">Aucun paiement</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-end fw-bold">Total Paiements</td>
                                    <td class="text-end fw-bold">
                                        <span t-field="doc.total_payment"
                                              t-options="{'widget': 'float', 'precision': 2}"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>