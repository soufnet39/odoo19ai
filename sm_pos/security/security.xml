<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Catégorie des groupes Point de vente SM -->
        <record id="module_category_sm_pos" model="ir.module.category">
            <field name="name">Comptoire SM</field>
            <field name="sequence">110</field>
        </record>

        <!-- Privilège des groupes Point de vente SM -->
        <record id="module_privilege_sm_pos" model="res.groups.privilege">
            <field name="name">Point de vente SM</field>
            <field name="sequence">110</field>
            <field name="category_id" ref="module_category_sm_pos"/>
        </record>

        <!-- Groupe de base : sm_pos_user -->
        <record id="sm_pos_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="privilege_id" ref="module_privilege_sm_pos"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Groupe gestionnaire : hérite des privilèges de sm_pos_user -->
        <record id="sm_pos_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="privilege_id" ref="module_privilege_sm_pos"/>
            <field name="implied_ids" eval="[(4, ref('sm_pos_user'))]"/>
        </record>

        <!-- Groupe administrateur : hérite des privilèges de sm_pos_manager -->
        <record id="sm_pos_admin" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="privilege_id" ref="module_privilege_sm_pos"/>
            <field name="implied_ids" eval="[(4, ref('sm_pos_manager'))]"/>
        </record>

    </data>
</odoo>