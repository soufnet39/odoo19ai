<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Séquence des sessions -->
        <record id="sequence_sm_pos_session" model="ir.sequence">
            <field name="name">Session du point de vente</field>
            <field name="code">sm_pos.session</field>
            <field name="prefix">POS/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Séquence des commandes du point de vente -->
        <record id="sequence_sm_sales_order_pos" model="ir.sequence">
            <field name="name">Commande du point de vente</field>
            <field name="code">sm_sales.order.pos</field>
            <field name="prefix">VC/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>