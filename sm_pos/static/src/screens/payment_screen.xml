<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="sm_pos.PaymentScreen">
        <div class="o_sm_pos_payment_screen d-flex h-100">
            <div class="flex-grow-1 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0">Paiement</h4>
                    <button class="btn btn-outline-secondary" t-on-click="back">
                        <i class="fa fa-arrow-left me-1"/> Retour
                    </button>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <h6>Modes de paiement</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <button t-foreach="pos.paymentModes" t-as="mode" t-key="mode.id"
                                    t-attf-class="btn #{state.selectedMode &amp;&amp; state.selectedMode.id === mode.id ? 'btn-primary' : 'btn-outline-primary'}"
                                    t-on-click="() => this.selectMode(mode)">
                                <t t-esc="mode.name"/>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <span>Total</span><span class="fw-bold" t-esc="orderTotal.toFixed(2)"/>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>Payé</span><span t-esc="paidTotal.toFixed(2)"/>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Reste à payer</span><span class="text-danger fw-bold" t-esc="remaining.toFixed(2)"/>
                                </div>
                                <input type="text" class="form-control text-end fs-4 mb-2"
                                       t-model="state.amountInput" placeholder="0.00"/>
                                <div t-if="change > 0" class="d-flex justify-content-between text-success">
                                    <span>Monnaie rendue</span><span class="fw-bold" t-esc="change.toFixed(2)"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <Numpad onInput.bind="onInput" onBackspace.bind="onBackspace" onClear.bind="onClear"/>
                    </div>
                </div>
                <div t-if="state.error" class="alert alert-danger mt-3 py-2" t-esc="state.error"/>
                <button class="btn btn-success btn-lg w-100 mt-3" t-on-click="pay"
                        t-att-disabled="state.paying">
                    <i class="fa fa-check me-1"/> Confirmer le paiement
                </button>
            </div>
        </div>
    </t>

</templates>