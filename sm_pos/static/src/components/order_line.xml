<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="sm_pos.OrderLine">
        <div t-attf-class="o_sm_pos_order_line d-flex justify-content-between align-items-center py-2 px-3 #{props.isSelected ? 'o_line_selected' : ''}"
             t-on-click="props.onClick"
             role="button">
            <div class="d-flex align-items-baseline gap-2 flex-grow-1 overflow-hidden">
                <span class="o_line_qty fw-bold fs-6" t-esc="props.line.qty"/>
                <div class="d-flex flex-column text-truncate">
                    <span class="o_line_name fw-semibold text-truncate" t-esc="props.line.name"/>
                    <span class="o_line_unit_desc text-muted small">
                        <t t-esc="formattedUnitPrice"/> / Unité(s)
                        <t t-if="props.line.discount &gt; 0">
                            <span class="text-danger ms-1">(-<t t-esc="props.line.discount"/>%)</span>
                        </t>
                    </span>
                </div>
            </div>
            <div class="text-end ps-2">
                <span class="o_line_total fw-bold" t-esc="formattedTotal"/>
            </div>
        </div>
    </t>

</templates>