<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="sm_pos.ProductCard">
        <div class="o_sm_pos_product_card_wrapper">
            <div class="card o_sm_pos_product_card h-100 position-relative"
                 t-attf-class="#{cartQty &gt; 0 ? 'o_in_cart' : ''}"
                 t-on-click="props.onClick"
                 role="button">
                <!-- Image container with cart quantity badge -->
                <div class="o_sm_pos_product_img_box position-relative">
                    <img t-if="props.product.image_128"
                         t-att-src="'data:image/png;base64,' + props.product.image_128"
                         class="o_product_img" alt="Product"/>
                    <i t-else="" class="fa fa-cube fa-3x text-muted o_product_placeholder"/>
                    
                    <!-- Black badge with quantity in active cart -->
                    <span t-if="cartQty &gt; 0" class="o_cart_qty_badge position-absolute" t-esc="cartQty"/>
                </div>
                <!-- Card info -->
                <div class="card-body p-2 d-flex flex-column justify-content-between">
                    <div class="o_product_name fw-semibold" t-esc="props.product.name"/>
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <span class="o_product_code text-muted small" t-esc="props.product.code"/>
                        <span class="o_product_price fw-bold" t-esc="formattedPrice"/>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>