<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Modifie l'action des commandes de vente : exclut les commandes du point de vente -->
    <record id="sm_sales.action_sm_sales_order" model="ir.actions.act_window">
        <field name="domain">[('operation_type', '=', 'order'), ('is_pos_order', '=', False)]</field>
    </record>

     <!-- =============================== -->
    <!-- VUE LISTE DES COMMANDES DU POINT DE VENTE SM -->
    <!-- =============================== -->
    <record id="view_sm_pos_order_list" model="ir.ui.view">
        <field name="name">sm_sales.order.list</field>
        <field name="model">sm_sales.order</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <list string="Commandes du point de vente"  create="False"  decoration-bf="1">
                <field name="name" string="Commande"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="state" widget="badge"/>
                <field name="pos_config_id" />
                <field name="session_id"  />
                <field name="amount_ttc" string="Montant" sum="Somme"/>

            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="sm_pos_view_sm_sales_order_form" model="ir.ui.view">
        <field name="name">sm_pos.sm_sales.order.form</field>
        <field name="model">sm_sales.order</field>
        <field name="inherit_id" ref="sm_sales.view_sm_sales_order_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="is_pos_order" invisible="not is_pos_order"/>
                <field name="session_id" invisible="not is_pos_order"/>
                <field name="pos_config_id" invisible="not is_pos_order"/>
            </field>
        </field>
    </record>

    <!-- Vue recherche -->
    <record id="sm_pos_view_sm_sales_order_search" model="ir.ui.view">
        <field name="name">sm_pos.sm_sales.order.search</field>
        <field name="model">sm_sales.order</field>
        <field name="inherit_id" ref="sm_sales.view_sm_sales_order_search"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="session_id"/>
            </field>
            <filter name="group_date" position="after">
                <filter string="Commandes du point de vente" name="pos_orders"
                        domain="[('is_pos_order', '=', True)]"/>
            </filter>
        </field>
    </record>

    <!-- Action des commandes du point de vente -->
    <record id="action_sm_pos_order" model="ir.actions.act_window">
        <field name="name">Commandes du point de vente</field>
        <field name="res_model">sm_sales.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sm_pos_view_sm_sales_order_search"/>
        <field name="domain">[('operation_type', '=', 'order'), ('is_pos_order', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_id': ref('view_sm_pos_order_list'), 'view_mode': 'list'}), (0, 0, {'view_id': ref('sm_pos_view_sm_sales_order_form'), 'view_mode': 'form'})]"/>
    </record>
</odoo>