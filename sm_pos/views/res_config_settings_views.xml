<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_sm_pos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sm_pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <app data-string="Vente Comptoire" string="Point de vente" name="sm_pos">

                    <block title="Valeurs par défaut" name="sm_pos_defaults">
                        <setting id="sm_pos_default_stock"
                                 string="Stock par défaut"
                                 help="Stock utilisé par défaut lors de la création d'un nouveau point de vente.">
                            <field name="pos_default_stock_id"/>
                        </setting>
                        <setting id="sm_pos_default_pricelist"
                                 string="Liste de prix par défaut"
                                 help="Liste de prix utilisée par défaut lors de la création d'un nouveau point de vente.">
                            <field name="pos_default_pricelist_id"/>
                        </setting>
                        <setting id="sm_pos_default_boxe"
                                 string="Caisse par défaut"
                                 help="Caisse utilisée par défaut pour enregistrer les paiements du point de vente.">
                            <field name="pos_default_boxe_id"/>
                        </setting>
                    </block>

                    <block title="Reçu" name="sm_pos_receipt">
                        <setting id="sm_pos_receipt_show_tva"
                                 string="Afficher la TVA sur le reçu"
                                 help="Afficher le détail de la TVA sur le reçu du point de vente.">
                            <field name="pos_receipt_show_tva"/>
                        </setting>
                    </block>

                </app>

            </xpath>

        </field>
    </record>

</odoo>