<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- STOCK MOVEMENT SEARCH VIEW                                    -->
    <!-- Based on sm_sales.order.line with stock grouping              -->
    <!-- ============================================================ -->
    <record id="sm_stocks_stock_movement_search" model="ir.ui.view">
        <field name="name">sm_stocks.stock.movement.search</field>
        <field name="model">sm_sales.order.line</field>
        <field name="arch" type="xml">
            <search string="Mouvements de Stock">
                <!-- Searchable fields -->
                <field name="name"/>
                <field name="product_id"/>
                <field name="product_code"/>
                <field name="stock_id"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <field name="user_id"/>
                <separator/>
                <!-- Filters by order state -->
                <filter string="Brouillon" name="filter_draft" domain="[('order_id.state', '=', 'draft')]"/>
                <filter string="Confirmées" name="filter_confirmed" domain="[('order_id.state', '=', 'confirmed')]"/>
                <filter string="Annulées" name="filter_canceled" domain="[('order_id.state', '=', 'canceled')]"/>
                <separator/>
                <!-- Filters for qty tracking (field-to-field comparison not supported in search domains) -->
                <separator/>
                <filter string="Non livrées" name="filter_not_delivered" domain="[('is_not_delivered', '=', True)]"/>
                <filter string="Non reçues" name="filter_not_received" domain="[('is_not_received', '=', True)]"/>
                <!-- Group by -->
                <filter string="Produit" name="group_product" context="{'group_by': 'product_id'}"/>
                <filter string="Stock" name="group_stock" context="{'group_by': 'stock_id'}"/>
                <filter string="Partenaire" name="group_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Commande" name="group_order" context="{'group_by': 'order_id'}"/>
                <filter string="Vendeur" name="group_user" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- STOCK MOVEMENT LIST VIEW                                      -->
    <!-- Shows all order lines as stock movements                       -->
    <!-- ============================================================ -->
    <record id="sm_stocks_stock_movement_list" model="ir.ui.view">
        <field name="name">sm_stocks.stock.movement.list</field>
        <field name="model">sm_sales.order.line</field>
        <field name="arch" type="xml">
            <list string="Mouvements de Stock"  editable="bottom" create="0" edit="0"  delete="0" 
                  decoration-warning="order_id.state == 'draft'"
                  decoration-success="order_id.state == 'confirmed'"
                  decoration-danger="order_id.state == 'canceled'"
                  decoration-bf="1"
                  >
   
                <field name="stock_id" readonly="1" options="{'no_open': True}"/>
                <field name="order_id" string="Document"/>
                <field name="stock_state" decoration-danger="stock_state == 'returned'" 
                decoration-warning="stock_state == 'pending'"
                decoration-success="stock_state in ['received','delivered']"/>
                <!-- Partner -->
                <field name="partner_id" string="Client/Fournis." readonly="1" options="{'no_open': True}"/>
                <!-- Product -->
                <field name="product_code" optional="hide"/>
                <field name="product_id" readonly="1" options="{'no_open': True}"/>
                <field name="name" string="Désignation" optional='hide'/>
                <!-- Quantities -->
                <!-- <field name="qty" readonly="1" string="Qté commandée" optional='hide'  />              -->
                <field name="qty_value"  string="Qté Valeur" />
               
                <!-- Meta -->
                <field name="user_id" optional="hide"/>
            </list>
        </field>
    </record>

  

    <!-- ============================================================ -->
    <!-- STOCK MOVEMENT ACTION                                         -->
    <!-- ============================================================ -->
    <record id="sm_stocks_stock_movement_action" model="ir.actions.act_window">
        <field name="name">Mouvements de Stocks</field>
        <field name="res_model">sm_sales.order.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sm_stocks_stock_movement_search"/>
        <field name="context">{'search_default_group_product':1}</field>        
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun mouvement de stock
            </p>
            <p>
                Les lignes de commandes apparaissent ici avec leurs informations de stock.
            </p>
        </field>
    </record>

</odoo>
