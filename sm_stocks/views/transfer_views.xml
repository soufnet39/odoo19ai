<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- SEARCH VIEW                                                   -->
    <!-- ============================================================ -->
    <record id="sm_stocks_transfer_search" model="ir.ui.view">
        <field name="name">sm_stocks.transfer.search</field>
        <field name="model">sm_stocks.transfer</field>
        <field name="arch" type="xml">
            <search string="Rechercher des transferts">
                <field name="name"/>
                <field name="stock_source_id"/>
                <field name="stock_dest_id"/>
                <field name="user_id"/>
                <separator/>
                <filter string="Brouillon" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Transféré" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Annulé" name="filter_cancel" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter string="Aujourd'hui" name="filter_today" domain="[('date', '&gt;=', 'today'), ('date', '&lt;', 'today +1d')]"/>
                <filter string="Cette Semaine" name="filter_this_week" domain="[('date', '&gt;=', '=week_start'), ('date', '&lt;', '=week_start +1w')]"/>
                <filter string="Ce Mois" name="filter_this_month" domain="[('date', '&gt;=', 'today =1d'), ('date', '&lt;', 'today =1d +1m')]"/>
                <separator/>
                <filter string="Date" name="filter_date" date="date"/>
                <!-- Group by -->
                <filter string="Stock source" name="group_stock_source" context="{'group_by': 'stock_source_id'}"/>
                <filter string="Stock destination" name="group_stock_dest" context="{'group_by': 'stock_dest_id'}"/>
                <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Responsable" name="group_user" context="{'group_by': 'user_id'}"/>
                <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- LIST VIEW                                                     -->
    <!-- ============================================================ -->
    <record id="sm_stocks_transfer_list" model="ir.ui.view">
        <field name="name">sm_stocks.transfer.list</field>
        <field name="model">sm_stocks.transfer</field>
        <field name="arch" type="xml">
            <list string="Transferts entre stocks"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'cancel'"
                  decoration-bf="1">
                <field name="name" string="Numéro"/>
                <field name="date"/>
                <field name="stock_source_id"/>
                <field name="stock_dest_id"/>
                <field name="lines_count" string="Nb Articles"/>
                <field name="user_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- FORM VIEW                                                     -->
    <!-- ============================================================ -->
    <record id="sm_stocks_transfer_form" model="ir.ui.view">
        <field name="name">sm_stocks.transfer.form</field>
        <field name="model">sm_stocks.transfer</field>
        <field name="arch" type="xml">
            <form string="Transfert entre stocks">
                <header>
                    <button name="action_validate" string="Valider" type="object"
                            class="btn btn-success" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Annuler" type="object"
                            class="btn btn-secondary" invisible="state == 'cancel'"
                            confirm="Êtes-vous sûr de vouloir annuler ce transfert ?"/>
                    <button name="action_draft" string="Remettre en brouillon" type="object"
                            class="btn btn-secondary" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet class="silver">
                    <widget name="web_ribbon" title="Brouillon" bg_color="bg-info" invisible="state != 'draft'"/>
                    <widget name="web_ribbon" title="Transféré" bg_color="bg-success" invisible="state != 'done'"/>
                    <widget name="web_ribbon" title="Annulé" bg_color="bg-danger" invisible="state != 'cancel'"/>

                    <div class="oe_title">
                        <h1>
                            <span>Transfert : </span>
                            <field name="name" readonly="1" class="d-inline"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Stocks">
                            <field name="stock_source_id" options="{'no_open': True, 'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="stock_dest_id" options="{'no_open': True, 'no_create': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Informations">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="user_id" options="{'no_open': True, 'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_open': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Articles" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="rest_in_stock" readonly="1" string="Dispo Source"/>
                                    <field name="qty" string="Quantité"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Notes ou observations sur ce transfert..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACTION                                                        -->
    <!-- ============================================================ -->
    <record id="sm_stocks_transfer_action" model="ir.actions.act_window">
        <field name="name">Entre Stocks</field>
        <field name="res_model">sm_stocks.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sm_stocks_transfer_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier transfert entre stocks
            </p>
            <p>
                Déplacez des quantités d'articles d'un stock source vers un stock destination.
            </p>
        </field>
    </record>

</odoo>
