<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- EXTEND SM_PURCHASES PURCHASE LIST VIEW                       -->
    <!-- Adds stock_id column to purchase list                         -->
    <!-- ============================================================ -->
    <record id="sm_stocks_view_sm_purchases_purchase_list" model="ir.ui.view">
        <field name="name">sm_stocks.sm_purchases.purchase.list</field>
        <field name="model">sm_sales.order</field>
        <field name="inherit_id" ref="sm_purchases.view_sm_purchases_purchase_list"/>
        <field name="arch" type="xml">
            <field name="amount_ttc" position="before">
                <field name="stock_id"/>
            </field>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- EXTEND SM_PURCHASES PURCHASE FORM VIEW                       -->
    <!-- Adds stock_id field to purchase form                          -->
    <!-- ============================================================ -->
    <record id="sm_stocks_view_sm_purchases_purchase_form" model="ir.ui.view">
        <field name="name">sm_stocks.sm_purchases.purchase.form</field>
        <field name="model">sm_sales.order</field>
        <field name="inherit_id" ref="sm_purchases.view_sm_purchases_purchase_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="go_receipt" string="Réception" type="object"
                                class="btn btn-secondary rosy" invisible="0"/>
            </header>
            <field name="user_id" position="after">               
                <field name="order_lines_count" invisible="1"/>
                <field name="stock_id" options="{'no_open': True}" readonly="order_lines_count>0"/>
            </field>
          
            <!-- Show remaining stock under the product in the order line form -->
            <field name="product_id" position="after">
                <field name="rest_in_stock" readonly="1"/>
            </field>
            <group id='add_article' position="after">
              <div  invisible="parent.stock_id" class="text-center text-danger p-4">
                    Il faut choisir un stock destination d'abord!..
              </div>
            </group>
            <group id='add_article' position="attributes">
               <attribute name="invisible">not (parent.stock_id or False)</attribute>
            </group>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- EXTEND SM_PURCHASES PURCHASE SEARCH VIEW                     -->
    <!-- Adds stock_id filter                                          -->
    <!-- ============================================================ -->
    <record id="sm_stocks_view_sm_purchases_purchase_search" model="ir.ui.view">
        <field name="name">sm_stocks.sm_purchases.purchase.search</field>
        <field name="model">sm_sales.order</field>
        <field name="inherit_id" ref="sm_purchases.view_sm_purchases_purchase_search"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="stock_id"/>
            </field>
            <filter name="group_date" position="after">
                <filter string="Stock" name="group_stock" context="{'group_by': 'stock_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
