<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
      <!-- this initialization is needed because default values is 'True'
      If it was 'False' it will be not needed at all -->
        <function model="ir.config_parameter" name="set_param">
            <value eval="'sm_stocks.delivery_confirmed_by_default'"/>
            <value eval="'True'"/>
        </function>

        <function model="ir.config_parameter" name="set_param">
            <value eval="'sm_stocks.reception_confirmed_by_default'"/>
            <value eval="'True'"/>
        </function>
    </data>
</odoo>