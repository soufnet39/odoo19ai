<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Catégorie pour les groupes Stocks SM -->
        <record id="module_category_sm_stocks" model="ir.module.category">
            <field name="name">Stocks SM</field>
            <field name="sequence">100</field>
        </record>

        <!-- Privilège pour les groupes Stocks SM -->
        <record id="module_privilege_sm_stocks" model="res.groups.privilege">
            <field name="name">Stocks SM</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="module_category_sm_stocks"/>
        </record>

        <!-- Groupe de base : sm_stocks_user -->
        <record id="sm_stocks_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="privilege_id" ref="module_privilege_sm_stocks"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Groupe Gestionnaire : hérite des privilèges de sm_stocks_user -->
        <record id="sm_stocks_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="privilege_id" ref="module_privilege_sm_stocks"/>
            <field name="implied_ids" eval="[(4, ref('sm_stocks_user'))]"/>
        </record>

        <!-- Groupe Administrateur : hérite des privilèges de sm_stocks_manager -->
        <record id="sm_stocks_admin" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="privilege_id" ref="module_privilege_sm_stocks"/>
            <field name="implied_ids" eval="[(4, ref('sm_stocks_manager'))]"/>
        </record>

        <!-- Règles d'enregistrement : les listes de prix ne sont visibles/utilisables que par les utilisateurs assignés.
