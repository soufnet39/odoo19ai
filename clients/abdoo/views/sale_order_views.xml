<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sm_sales_order_form_inherit_abdoo" model="ir.ui.view">
        <field name="name">sm_sales.order.form.abdoo</field>
        <field name="model">sm_sales.order</field>
        <field name="inherit_id" ref="sm_sales.view_sm_sales_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='print_order']" position="after">
                <button name="action_print_narrow_order" 
                        string="Imprimer Ticket (10cm)" 
                        type="object"
                        class="btn btn-secondary" 
                        icon="fa-print"
                        invisible="operation_type != 'order' or '_&lt;' in name or amount_ttc == 0"/>
            </xpath>
        </field>
    </record>
</odoo>
