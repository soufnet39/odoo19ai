<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Catégorie des groupes Abdoo SM -->
        <record id="module_category_abdoo" model="ir.module.category">
            <field name="name">Abdoo SM</field>
            <field name="sequence">100</field>
        </record>

        <!-- Privilège des groupes Abdoo SM -->
        <record id="module_privilege_abdoo" model="res.groups.privilege">
            <field name="name">Abdoo SM</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="module_category_abdoo"/>
        </record>

        <!-- Groupe de base : abdoo_user -->
        <record id="abdoo_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="privilege_id" ref="module_privilege_abdoo"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Groupe gestionnaire : hérite des privilèges de abdoo_user -->
        <record id="abdoo_manager" model="res.groups">
            <field name="name">Gestionnaire</field>
            <field name="privilege_id" ref="module_privilege_abdoo"/>
            <field name="implied_ids" eval="[(4, ref('abdoo_user'))]"/>
        </record>

        <!-- Groupe administrateur : hérite des privilèges de abdoo_manager -->
        <record id="abdoo_admin" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="privilege_id" ref="module_privilege_abdoo"/>
            <field name="implied_ids" eval="[(4, ref('abdoo_manager'))]"/>
        </record>

        

    </data>
</odoo>
