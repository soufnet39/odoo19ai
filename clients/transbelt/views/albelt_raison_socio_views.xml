<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Raison Socio List View -->
    <record id="view_albelt_raison_socio_tree" model="ir.ui.view">
        <field name="name">albelt.raison_socio.list</field>
        <field name="model">albelt.raison_socio</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Raison Socio Form View -->
    <record id="view_albelt_raison_socio_form" model="ir.ui.view">
        <field name="name">albelt.raison_socio.form</field>
        <field name="model">albelt.raison_socio</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Raison Socio Search View -->
    <record id="view_albelt_raison_socio_search" model="ir.ui.view">
        <field name="name">albelt.raison_socio.search</field>
        <field name="model">albelt.raison_socio</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Raison Socio Action -->
    <record id="action_albelt_raison_socio" model="ir.actions.act_window">
        <field name="name">Raisons Social</field>
        <field name="res_model">albelt.raison_socio</field>
        <field name="view_mode">list,form</field>
    </record>

   
</odoo>
