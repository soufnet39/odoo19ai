<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Héritage formulaire client commercial sm_sales.partner -->
    <record id="view_sm_sales_partner_form_inherit_abdoo_web" model="ir.ui.view">
        <field name="name">sm_sales.partner.form.inherit.abdoo_web</field>
        <field name="model">sm_sales.partner</field>
        <field name="inherit_id" ref="sm_sales.sm_sales_customer_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='fiscality']" position="after">
                <group string="Catalogue Web E-commerce" colspan="6">
                    <field name="can_view_catalog_prices"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
