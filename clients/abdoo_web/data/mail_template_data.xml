<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_pre_order_confirmation" model="mail.template">
            <field name="name">Pré-commande Web: Confirmation &amp; Détails</field>
            <field name="model_id" ref="abdoo_web.model_abdoo_web_pre_order"/>
            <field name="subject">Confirmation de votre pré-commande {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted or 'noreply@abdoo.com') }}</field>
            <field name="email_to">{{ object.customer_email or '' }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #333333; line-height: 1.6; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e2e8f0; border-radius: 8px;">
                    <div style="text-align: center; margin-bottom: 20px;">
                        <h2 style="color: #1e3a8a; margin: 0;">Confirmation de Pré-commande</h2>
                        <p style="color: #64748b; font-size: 15px; margin: 5px 0 0 0;">Référence : <strong><t t-out="object.name"/></strong></p>
                    </div>

                    <p>Bonjour <strong t-out="object.customer_name or 'Client'"/>,</p>
                    <p>Nous vous remercions pour l'intérêt que vous portez à nos produits. Votre pré-commande a bien été enregistrée et transmise à notre équipe commerciale.</p>

                    <table style="width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 13px;">
                        <thead>
                            <tr style="background-color: #f1f5f9; text-align: left;">
                                <th style="padding: 10px; border: 1px solid #cbd5e1;">Article</th>
                                <th style="padding: 10px; border: 1px solid #cbd5e1; text-align: center;">Réf.</th>
                                <th style="padding: 10px; border: 1px solid #cbd5e1; text-align: center;">Qté</th>
                                <t t-if="object.has_prices">
                                    <th style="padding: 10px; border: 1px solid #cbd5e1; text-align: right;">Prix Unitaire</th>
                                    <th style="padding: 10px; border: 1px solid #cbd5e1; text-align: right;">Sous-total</th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="object.line_ids" t-as="line">
                                <tr>
                                    <td style="padding: 10px; border: 1px solid #e2e8f0;">
                                        <strong t-out="line.product_id.name"/><br/>
                                        <small style="color: #64748b;" t-if="line.description" t-out="line.description"/>
                                    </td>
                                    <td style="padding: 10px; border: 1px solid #e2e8f0; text-align: center;">
                                        <t t-out="line.product_code or '-'"/>
                                    </td>
                                    <td style="padding: 10px; border: 1px solid #e2e8f0; text-align: center;">
                                        <t t-out="line.quantity"/>
                                    </td>
                                    <t t-if="object.has_prices">
                                        <td style="padding: 10px; border: 1px solid #e2e8f0; text-align: right;">
                                            <t t-out="'%.2f' % line.price_unit"/>
                                        </td>
                                        <td style="padding: 10px; border: 1px solid #e2e8f0; text-align: right;">
                                            <t t-out="'%.2f' % line.price_subtotal"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                        <t t-if="object.has_prices">
                            <tfoot>
                                <tr style="background-color: #f8fafc; font-weight: bold;">
                                    <td colspan="4" style="padding: 10px; border: 1px solid #cbd5e1; text-align: right;">Total estimé :</td>
                                    <td style="padding: 10px; border: 1px solid #cbd5e1; text-align: right; color: #1e3a8a;">
                                        <t t-out="'%.2f' % object.amount_total"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </t>
                    </table>

                    <div style="background-color: #f8fafc; border-left: 4px solid #3b82f6; padding: 12px; margin-top: 15px; border-radius: 4px;">
                        <p style="margin: 0; font-size: 13px;"><strong>Vos coordonnées :</strong></p>
                        <p style="margin: 4px 0 0 0; font-size: 13px; color: #475569;">
                            Téléphone : <t t-out="object.customer_phone or 'Non spécifié'"/><br/>
                            <t t-if="object.customer_company">Société : <t t-out="object.customer_company"/><br/></t>
                            <t t-if="object.notes">Remarques : <t t-out="object.notes"/></t>
                        </p>
                    </div>

                    <p style="margin-top: 25px;">Notre équipe commerciale examinera votre demande et prendra contact avec vous dans les plus brefs délais.</p>

                    <div style="margin-top: 30px; padding-top: 15px; border-top: 1px solid #e2e8f0; font-size: 12px; color: #94a3b8; text-align: center;">
                        <p style="margin: 0;"><t t-out="object.company_id.name or 'Abdoo'"/></p>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>
