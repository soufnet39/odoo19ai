<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Élément du menu principal du site web : Boutique -->
        <record id="menu_boutique" model="website.menu">
            <field name="name">Boutique</field>
            <field name="url">/boutique</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">20</field>
        </record>

        <!-- Élément du menu principal : Mes Pré-commandes (pour utilisateurs connectés) -->
        <record id="menu_my_pre_orders" model="website.menu">
            <field name="name">Mes Pré-commandes</field>
            <field name="url">/mes-precommandes</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">25</field>
            <field name="group_ids" eval="[(4, ref('base.group_portal')), (4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
